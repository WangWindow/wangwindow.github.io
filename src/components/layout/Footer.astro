---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/site.config";
---

<footer
  class="text-muted mt-auto flex flex-wrap items-center justify-center gap-x-3 gap-y-2 pb-10 pt-20 text-xs"
>
  <a
    class="hover:text-link inline-flex items-center gap-1.5 transition-colors"
    href="https://github.com/WangWindow"
    rel="noreferrer"
    target="_blank"
  >
    <Icon aria-hidden="true" class="size-4" name="mdi:github" />
    <span>{siteConfig.author}</span>
  </a>
  <span aria-hidden="true">·</span>
  <span>
    Powered by <a
      class="cactus-link"
      href="https://github.com/chrismwilliams/astro-theme-cactus"
      rel="noreferrer"
      target="_blank">astro-theme-cactus</a
    >
  </span>
</footer>
