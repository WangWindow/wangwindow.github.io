---
import type { TocItem } from "@/utils/generateToc";

interface Props {
  heading: TocItem;
}

const {
  heading: { children, depth, slug, text },
} = Astro.props;
---

<li class={`${depth > 2 ? "ms-3" : ""}`}>
  <a
    class={`block line-clamp-2 hover:text-link ${depth <= 2 ? "mt-2" : "mt-1 text-xs text-muted"}`}
    href={`#${slug}`}>{text}</a
  >
  {
    !!children.length && (
      <ol>
        {children.map((subheading) => (
          <Astro.self heading={subheading} />
        ))}
      </ol>
    )
  }
</li>
