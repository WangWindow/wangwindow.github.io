---
import "@/styles/blocks/search.css";
import { Icon } from "astro-icon/components";

const bundlePath = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/pagefind/`;
const searchScript = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/scripts/search.js`;
---

<button
  aria-expanded="false"
  aria-haspopup="dialog"
  aria-label="Search"
  class="search-control ms-auto inline-grid size-9 place-items-center p-2 text-muted transition-colors hover:text-link"
  id="search-control"
  type="button"
>
  <Icon aria-hidden="true" class="size-5" name="mdi:magnify" />
</button>

<dialog
  aria-labelledby="search-title"
  class="site-search-dialog"
  data-bundle-path={bundlePath}
  id="search-dialog"
>
  <div class="site-search-header">
    <h2 id="search-title">
      <Icon aria-hidden="true" class="size-5" name="mdi:magnify" />
      Search
    </h2>
    <button aria-label="Close" class="site-search-close" id="search-close" type="button">
      <Icon aria-hidden="true" class="size-5" name="mdi:close" />
    </button>
  </div>

  <form class="site-search-form" id="site-search-form" role="search">
    <label class="sr-only" for="site-search-input">Search</label>
    <input autocomplete="off" enterkeyhint="search" id="site-search-input" placeholder="Type here..." type="search" />
    <button
      aria-label="Clear search"
      class="site-search-clear"
      hidden
      id="site-search-clear"
      title="Clear search"
      type="button"
    >
      <Icon aria-hidden="true" class="size-4" name="mdi:backspace-outline" />
    </button>
  </form>

  <p aria-live="polite" class="site-search-status" hidden id="site-search-status"></p>
  <ol class="site-search-results" id="site-search-results"></ol>
  <button class="site-search-more" hidden id="site-search-more" type="button">加载更多结果</button>
</dialog>

<script is:inline src={searchScript} type="module"></script>
